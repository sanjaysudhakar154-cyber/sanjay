generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  name             String?
  passwordHash     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  baseCurrency     String    @default("USD")
  experience       String?
  riskPerTrade     Float?
  
  accounts         Account[]
  trades           Trade[]
  strategies       Strategy[]
}

model Account {
  id               String    @id @default(cuid())
  userId           String
  name             String
  startingBalance  Float     @default(0)
  currentBalance   Float     @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades           Trade[]
}

model Trade {
  id               String    @id @default(cuid())
  userId           String
  accountId        String
  
  // Identification
  date             DateTime
  market           String    // Forex, Crypto, Stocks, etc.
  asset            String    // EUR/USD, BTC
  direction        String    // Long, Short
  
  // Entry
  entryPrice       Float
  positionSize     Float
  leverage         Float?
  
  // Risk
  stopLoss         Float?
  takeProfit       Float?
  riskAmount       Float?
  riskPercentage   Float?
  
  // Exit
  exitPrice        Float?
  exitDate         DateTime?
  grossPnL         Float?
  fees             Float?    @default(0)
  commission       Float?    @default(0)
  netPnL           Float?
  actualRMultiple  Float?
  
  // Strategy & Psychology
  strategyId       String?
  setup            String?
  timeframe        String?
  emotionBefore    String?
  emotionDuring    String?
  emotionAfter     String?
  disciplineScore  Int?      // 1-10
  followedPlan     Boolean?  @default(true)
  
  // Journaling
  journalNotes     String?
  mistakes         String?   // Comma separated for now
  
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  account          Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  strategy         Strategy? @relation(fields: [strategyId], references: [id], onDelete: SetNull)
}

model Strategy {
  id               String    @id @default(cuid())
  userId           String
  name             String
  description      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades           Trade[]
}
